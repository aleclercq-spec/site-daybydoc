---
import Base from "./Base.astro";
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<Base title={title} description={description}>
  <article class="legal container">
    <slot />
  </article>
</Base>
<style>
  .legal { max-width: 760px; padding: 96px var(--gutter) 120px; }
  .legal :global(h1) { font-size: 38px; line-height: 1.25; font-weight: 500; letter-spacing: -0.01em; color: var(--primary); }
  .legal :global(h2) { margin-top: 48px; font-size: 24px; line-height: 1.3; font-weight: 600; color: var(--primary-800); }
  .legal :global(p), .legal :global(li) { margin-top: 14px; font-size: 16px; line-height: 1.7; color: var(--neutral-7); }
  /* Les retours à la ligne simples du texte (adresses, coordonnées) sont conservés */
  .legal :global(p) { white-space: pre-line; }
  .legal :global(ul) { margin-top: 8px; padding-left: 22px; list-style: disc; }
  .legal :global(li) { margin-top: 8px; }
  .legal :global(li)::marker { color: var(--coral); }
  .legal :global(a) { color: var(--primary); }
  .legal :global(table) {
    display: block; max-width: 100%; margin-top: 20px; overflow-x: auto;
    border-collapse: collapse; font-size: 15px; line-height: 1.55;
  }
  .legal :global(th), .legal :global(td) { padding: 12px 16px; border: 1px solid var(--neutral-3); text-align: left; vertical-align: top; }
  .legal :global(th) { background: var(--neutral-2); font-weight: 600; color: var(--primary-800); }
  @media (max-width: 767px) {
    .legal { padding-block: 56px 72px; }
    .legal :global(h1) { font-size: 28px; }
    .legal :global(h2) { margin-top: 36px; font-size: 21px; }
  }
</style>
