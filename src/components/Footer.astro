---
import logo from "../assets/logo-daybydoc-blanc.svg";
const onHome = /^\/(index(\.html)?)?$/.test(Astro.url.pathname);
---
<footer class="foot">
  <div class="container">
    <div class="foot__cols">
      <div class="foot__brand">
        <img src={logo.src} alt="DaybyDoc" width="131" height="30" />
        <p>Le planning des gardes pour les ADOPS, maisons médicales et associations de régulation.</p>
      </div>
      <nav class="foot__nav" aria-label="Liens du pied de page">
        <a href={`${onHome ? "" : "/"}#demo`}>Demander une démo</a>
        <a href="https://dbyd.fr">Se connecter</a>
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/confidentialite">Politique de confidentialité</a>
      </nav>
      <div class="foot__contact">
        <p class="foot__label">Contact</p>
        <a href="mailto:contact@daybydoc.fr">contact@daybydoc.fr</a>
      </div>
    </div>
    <p class="foot__legal">Conçu et maintenu par 9troisquarts.</p>
  </div>
</footer>
<style>
  .foot { background: var(--primary-800); color: var(--sidebar-text); padding: 72px var(--gutter) 40px; }
  .foot__cols { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 40px 64px; }
  .foot__brand { flex: 1 1 280px; min-width: 0; }
  .foot__brand img { display: block; height: 30px; width: auto; }
  .foot__brand p { margin-top: 18px; font-size: 16px; line-height: 1.55; color: var(--primary-100); }
  .foot__nav { flex: 1 1 260px; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .foot a { display: flex; align-items: center; min-height: 44px; font-size: 15px; color: var(--primary-100); text-decoration: none; }
  .foot a:hover { color: #fff; }
  .foot__contact { flex: 1 1 220px; min-width: 0; }
  .foot__label { font-size: 14px; font-weight: 600; color: #fff; }
  .foot__contact a { display: inline-flex; margin-top: 4px; text-decoration: underline; }
  .foot__legal { margin-top: 56px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, 0.14); font-size: 14px; color: var(--sidebar-text); }
  @media (max-width: 767px) { .foot { padding: 56px var(--gutter) 32px; } }
</style>
