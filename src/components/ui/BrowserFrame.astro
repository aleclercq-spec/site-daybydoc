---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** address : barre grise + champ d'adresse ; dots : barre grise ; mini : trois points sur fond blanc */
  variant?: "address" | "dots" | "mini";
  sizes?: string;
  widths?: number[];
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}
const {
  src, alt, variant = "dots", sizes = "(min-width: 1100px) 700px, 100vw",
  widths = [480, 720, 1080], loading = "lazy", fetchpriority, class: className,
} = Astro.props;
---
<div class:list={["frame card", `frame--${variant}`, className]}>
  <div class="frame__bar" aria-hidden="true">
    <span></span><span></span><span></span>
    {variant === "address" && <span class="frame__url"></span>}
  </div>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} format="webp" quality={85}
    loading={loading} fetchpriority={fetchpriority} />
</div>
<style>
  .frame { overflow: hidden; }
  .frame__bar {
    display: flex; align-items: center; gap: 6px;
    height: 36px; padding: 0 14px;
    background: var(--neutral-2); border-bottom: 1px solid var(--neutral-3);
  }
  .frame--mini .frame__bar { height: auto; padding: 12px 14px; background: transparent; }
  .frame__bar span { width: 10px; height: 10px; border-radius: 9999px; background: var(--neutral-4); }
  .frame--mini .frame__bar span { width: 9px; height: 9px; }
  .frame__bar .frame__url {
    width: 220px; height: 18px; margin-left: 16px; background: #fff; border: 1px solid var(--neutral-3);
  }
  .frame img { display: block; width: 100%; height: auto; }
</style>
