---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { src: ImageMetadata; alt: string; loading?: "eager" | "lazy" }
const { src, alt, loading = "lazy" } = Astro.props;
---
<div class="phone">
  <div class="phone__screen">
    <Image src={src} alt={alt} widths={[200, 320]} sizes="(min-width: 1100px) 220px, 160px" format="webp" quality={85} loading={loading} />
  </div>
</div>
<style>
  .phone {
    width: 100%; aspect-ratio: 9 / 18; padding: 7px;
    background: var(--primary-800); border-radius: 30px;
    box-shadow: 0 12px 40px rgba(27, 50, 68, 0.24);
  }
  .phone__screen { height: 100%; border-radius: 23px; overflow: hidden; background: #f3f7f8; }
  .phone__screen img { display: block; width: 100%; height: auto; }
</style>
