---
import { Image } from "astro:assets";
import Dot from "../ui/Dot.astro";
import planning from "../../assets/capture-hero-planning.png";
import carte from "../../assets/carte-secteurs.svg?raw";

const notifications = [
  { id: "regulation", dot: "#E8872B", title: "Régulation · Nuit du samedi", sub: "20:00 - 08:00 · Dr Martin", badge: "Pourvue", tone: "ok" },
  { id: "vacante", dot: "#F28C6F", title: "Garde vacante pourvue", sub: "Médecin mobile · en 4 min", badge: "Nouveau", tone: "new" },
  { id: "echange", dot: "#7C5CC4", title: "Échange accepté", sub: "Secteur Bocage · dim. 14 déc.", badge: "Confirmé", tone: "ok" },
];
const activites = [
  { label: "Régulation", icon: '<path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"></path><path d="M21 16v2a4 4 0 0 1-4 4h-5"></path>' },
  { label: "Gardes de secteur", icon: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle>' },
  { label: "Maisons médicales de garde", icon: '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path>' },
  { label: "Médecins mobiles", icon: '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path><circle cx="7" cy="17" r="2"></circle><path d="M9 17h6"></path><circle cx="17" cy="17" r="2"></circle>' },
];
---
<section class="section section--teal hero" id="hero" aria-labelledby="hero-titre">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="hero__eyebrow">Logiciel de planning des gardes pour les ADOPS, maisons médicales et associations de régulation</p>
      <h1 id="hero-titre">Vos gardes médicales, réparties en un clic, selon <strong>vos règles</strong><Dot /></h1>
      <p class="hero__lead">DaybyDoc se paramètre selon les règles de votre ADOPS, répartit les gardes automatiquement, gère échanges et gardes vacantes, et transmet le planning à Ordigard.</p>
      <div class="hero__actions">
        <a class="btn btn--coral" href="#demo">Demander une démo</a>
        <a class="hero__video" href="#temoignage">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>Voir le témoignage de l'ADOPS59
        </a>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__map" aria-hidden="true"><Fragment set:html={carte} /></div>

      {notifications.map((n) => (
        <div class={`card hero__notif hero__notif--${n.id}`}>
          <span class="hero__notif-dot" aria-hidden="true" style={`background:${n.dot}`}></span>
          <span class="hero__notif-body">
            <span class="hero__notif-title">{n.title}</span>
            <span class="hero__notif-sub">{n.sub}</span>
          </span>
          <span class={`hero__notif-badge hero__notif-badge--${n.tone}`}>{n.badge}</span>
        </div>
      ))}

      <div class="hero__laptop">
        <div class="hero__screen">
          <div class="hero__screen-inner">
            <Image src={planning} alt="Planning mensuel des gardes dans DaybyDoc, sur ordinateur"
              widths={[340, 680]} sizes="340px" format="webp" quality={85} loading="eager" fetchpriority="high" />
          </div>
        </div>
        <div class="hero__base"><span></span></div>
      </div>
    </div>
  </div>

  <div class="hero__band-wrap">
    <ul class="container hero__band" aria-label="Les activités gérées">
      {activites.map((a) => (
        <li>
          <span class="hero__band-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={a.icon} /></span>
          <p>{a.label}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .hero { position: relative; overflow: hidden; padding: 80px 0 0; border-top: 0; }
  .hero__inner {
    max-width: calc(1200px + 2 * var(--gutter)); padding-inline: var(--gutter);
    display: flex; flex-direction: column; gap: 48px;
  }
  .hero__text { min-width: 0; max-width: 540px; }
  .hero__eyebrow { font-size: 15px; font-weight: 500; letter-spacing: 0.01em; color: var(--c-text); }
  h1 {
    margin: 18px 0 22px; font-size: 46px; line-height: 1.15; font-weight: 500;
    letter-spacing: -0.02em; color: var(--c-heading);
  }
  h1 strong { font-weight: 700; }
  .hero__lead { font-size: 18px; line-height: 1.6; color: var(--c-muted); }
  .hero__actions { margin-top: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; }
  .hero__video {
    display: inline-flex; align-items: center; gap: 10px; min-height: 44px;
    font-size: 16px; font-weight: 500; color: var(--c-link); text-decoration: none;
  }
  .hero__video:hover { color: var(--c-link); text-decoration: underline; }

  /* Visuel : carte des secteurs en fond, ordinateur et notifications posés dessus */
  .hero__visual { position: relative; width: min(100%, 640px); height: 540px; margin-inline: auto; }
  .hero__map { position: absolute; top: 0; right: 0; width: min(580px, 100%); pointer-events: none; }
  .hero__map :global(svg) { display: block; width: 100%; height: auto; }
  .hero__notif {
    position: absolute; z-index: 2; display: flex; align-items: center; gap: 12px;
    padding: 12px 16px; min-width: 230px; border-radius: 12px; box-shadow: 0 12px 32px rgba(8, 40, 50, 0.22);
  }
  .hero__notif-dot { flex: none; width: 10px; height: 10px; border-radius: 9999px; }
  .hero__notif-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .hero__notif-title { font-size: 14px; font-weight: 600; line-height: 1.3; color: var(--c-title); }
  .hero__notif-sub { font-size: 13px; line-height: 1.3; color: var(--c-muted); }
  .hero__notif-badge { margin-left: auto; flex: none; padding: 3px 9px; border-radius: 9999px; font-size: 12px; font-weight: 600; }
  .hero__notif-badge--ok { color: #0f6b4f; background: #e3f4ec; }
  .hero__notif-badge--new { color: #8a3b22; background: #fdebe5; }
  .hero__notif--regulation { top: 76px; left: 0; }
  .hero__notif--echange { top: 0; right: 0; }
  .hero__notif--vacante { bottom: 0; left: 0; }

  .hero__laptop { position: absolute; right: 0; bottom: 0; width: 320px; }
  .hero__screen { padding: 10px 10px 12px; background: var(--primary-800); border-radius: 14px 14px 0 0; box-shadow: 0 18px 44px rgba(6, 31, 39, 0.45); }
  .hero__screen-inner { overflow: hidden; border-radius: 4px; background: #fff; }
  .hero__screen-inner :global(img) { display: block; width: 100%; height: auto; }
  .hero__base {
    position: relative; height: 14px; margin: 0 -26px; border-radius: 0 0 14px 14px;
    background: linear-gradient(#c9d3d5, #9fb0b4); box-shadow: 0 10px 24px rgba(6, 31, 39, 0.4);
  }
  .hero__base span {
    position: absolute; left: 50%; top: 0; width: 70px; height: 5px; margin-left: -35px;
    background: #8a9a9e; border-radius: 0 0 6px 6px;
  }

  /* Bandeau des activités, sur toute la largeur */
  .hero__band-wrap { position: relative; margin-top: 56px; background: rgba(6, 31, 39, 0.55); border-top: 1px solid rgba(255, 255, 255, 0.12); }
  .hero__band {
    padding: 22px var(--gutter); display: grid; gap: 16px 24px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .hero__band li { display: flex; align-items: center; gap: 12px; }
  .hero__band-icon {
    flex: none; width: 40px; height: 40px; border-radius: 9999px; background: rgba(255, 255, 255, 0.12);
    display: flex; align-items: center; justify-content: center; color: #fff;
  }
  .hero__band p { font-size: 15px; line-height: 1.35; font-weight: 500; color: var(--c-text); }

  /* Ordinateur : maquette 1440 px (texte à gauche, visuel à droite, 820 px de haut au plus) */
  @media (min-width: 1280px) {
    .hero__inner { flex-direction: row; align-items: center; gap: 64px; }
    .hero__text { flex: 1 1 460px; }
    .hero__visual { flex: 1 1 520px; width: auto; max-width: none; height: 580px; margin: 0; }
    .hero__map { top: -32px; right: -62px; width: 580px; }
    .hero__notif--regulation { top: 44px; left: -50px; }
    .hero__notif--echange { top: -8px; right: -24px; }
    .hero__notif--vacante { top: 410px; bottom: auto; left: -80px; }
    .hero__laptop { bottom: 8px; width: 340px; }
    .hero__band-wrap { margin-top: 64px; }
    .hero__band { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .hero__band p { white-space: nowrap; }
  }

  /* Mobile : texte, puis visuel (carte, ordinateur, deux notifications), puis bandeau sur deux colonnes */
  @media (max-width: 767px) {
    .hero { padding-top: 64px; }
    .hero__inner { gap: 40px; }
    h1 { font-size: min(38px, 9.6vw); margin: 16px 0 20px; }
    .hero__actions { margin-top: 28px; }
    .hero__visual { width: 100%; max-width: 480px; height: auto; aspect-ratio: 1 / 1.12; }
    .hero__map { width: 100%; }
    .hero__notif { min-width: 0; padding: 10px 12px; gap: 10px; }
    .hero__notif-title { font-size: 13px; }
    .hero__notif-sub { font-size: 12px; }
    .hero__notif-badge { padding: 2px 8px; font-size: 11px; }
    .hero__notif--regulation { top: 0; left: 0; }
    .hero__notif--echange { top: 42%; right: auto; left: 0; }
    .hero__notif--vacante { display: none; }
    .hero__laptop { width: 62%; }
    .hero__base { margin-inline: -10px; }
    .hero__band-wrap { margin-top: 40px; }
    .hero__band { gap: 16px; }
    .hero__band li { gap: 10px; }
  }
  @media (max-width: 400px) {
    .hero__visual { aspect-ratio: 1 / 1.25; }
  }
</style>
