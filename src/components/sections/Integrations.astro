---
import Dot from "../ui/Dot.astro";

const items = [
  { title: "Ordigard", text: "Le planning validé est transmis au tableau de garde de l'Ordre, sans double saisie.",
    icon: '<path d="M12 3v12"></path><path d="m8 11 4 4 4-4"></path><path d="M8 5H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-4"></path>' },
  { title: "Connexion par e-CPS", text: "Les médecins se connectent avec leur carte professionnelle de santé, via Pro Santé Connect.", badge: "e-CPS" },
  { title: "Agendas personnels", text: "Chaque médecin retrouve ses gardes dans son agenda habituel.",
    icon: '<path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path>' },
  { title: "Traçabilité", text: "Chaque création, modification ou échange est historisé, avec son auteur et sa date.",
    icon: '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path>' },
  { title: "Données protégées", text: "Données conformes au RGPD, hébergées en France.",
    icon: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path>' },
];
---
<section class="section section--teal" id="integrations" aria-labelledby="in-titre">
  <div class="container">
    <h2 id="in-titre">Connecté à vos outils, dans le respect des règles<Dot /></h2>
    <ul class="integ">
      {items.map((it) => (
        <li>
          <div class="integ__icon" aria-hidden="true">
            {it.badge ? it.badge : <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={it.icon} />}
          </div>
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .integ {
    margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--neutral-3);
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 32px;
  }
  .integ li { min-width: 0; }
  .integ__icon {
    width: 48px; height: 48px; border-radius: 9999px; background: var(--primary-50); color: var(--primary);
    display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; letter-spacing: 0.01em;
  }
  .integ h3 { margin-top: 20px; font-size: 16px; line-height: 1.4; font-weight: 600; color: var(--c-title); }
  .integ p { margin-top: 8px; font-size: 15px; line-height: 1.55; color: var(--c-muted); }
  @media (max-width: 1099px) { .integ { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    .integ { margin-top: 40px; padding-top: 24px; grid-template-columns: minmax(0, 1fr); row-gap: 28px; }
  }
</style>
